<li style="view-transition-name: task-<%= task._id %>;">
  <input type="checkbox"
    hx-put="/tasks/<%= task._id %>"
    hx-vals="js:{checked: this.checked}"
    hx-trigger="change"
    hx-target="#tasks"
    hx-swap="innerHTML transition:true"
    <% if (task.isChecked) { %> checked <% } %>
  >
  <p><%= task.title %></p>
  <button
    class="btn--delete"
    hx-delete="/tasks/<%= task._id %>"
    hx-confirm="Are you sure you want to delete task &quot;<%= task.title %>&quot;"
    hx-target="#tasks"
    hx-swap="innerHTML transition:true"
  >
    Delete
  </button>
</li>