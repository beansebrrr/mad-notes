<h2 style="view-transition-name: tasklist-head-pending;">Pending</h2>
  
<ul id="pendingTasks">
  <% tasks.forEach(task => { if (!task.isChecked) { %>
    <%- include("./taskItem", {task: task}) %>
  <% }}); %>
</ul>
  
<h2 style="view-transition-name: tasklist-head-completed;">Completed</h2>
  
<ul id="completedTasks">
  <% tasks.forEach(task => { if (task.isChecked) { %>
    <%- include("./taskItem", {task: task}) %>
  <% }}); %>
</ul>